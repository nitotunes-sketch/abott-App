<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health & Glucose Tracker Dashboard</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f5f7fb;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        h1 { color: #2c3e50; margin-bottom: 5px; }
        .user-badge {
            background-color: #e2e8f0;
            padding: 5px 15px;
            border-radius: 15px;
            font-size: 0.9rem;
            display: inline-block;
        }
        .card {
            background: white;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 25px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        h2 { color: #34495e; margin-top: 0; border-bottom: 2px solid #ecf0f1; padding-bottom: 8px; }
        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; font-size: 0.9rem; }
        input[type="file"], input[type="text"], textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
        }
        button {
            background-color: #3498db;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: bold;
            width: 100%;
        }
        button:hover { background-color: #2980b9; }
        .table-container {
            overflow-x: auto;
            margin-top: 15px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }
        th, td { padding: 10px; border-bottom: 1px solid #ddd; }
        th { background-color: #f8f9fa; color: #555; }
        tr:hover { background-color: #f1f2f6; }
        .status { color: #27ae60; font-weight: bold; margin-top: 10px; }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Health Dashboard</h1>
        <div id="user-info" class="user-badge">User: Antonio Russo (Male)</div>
    </header>

    <div class="grid">
        <div class="card">
            <h2>1. Import Data</h2>
            
            <div class="form-group">
                <label for="scale-file">Beurer Scale CSV File:</label>
                <input type="file" id="scale-file" accept=".csv">
            </div>

            <div class="form-group">
                <label for="libre-file">Abbott Libre 3 File (Coming Soon):</label>
                <input type="file" id="libre-file" accept=".csv, .txt" disabled placeholder="We will add this next!">
            </div>
            
            <button onclick="processFiles()">Process & Populate App</button>
            <div id="upload-status" class="status"></div>
        </div>

        <div class="card">
            <h2>2. Food & Notes Log</h2>
            <div class="form-group">
                <label for="meal-photo">Capture/Upload Meal Photo:</label>
                <input type="file" id="meal-photo" accept="image/*">
            </div>
            <div class="form-group">
                <label for="notes">Notes & Details (e.g., Nicotine Gum, context):</label>
                <textarea id="notes" rows="3" placeholder="Add extra details here..."></textarea>
            </div>
            <button onclick="alert('Meal logged! (This will save to history once database is connected)')">Log Meal Entry</button>
        </div>
    </div>

    <div class="card">
        <h2>Scale History Summary</h2>
        <p style="color: #7f8c8d; font-size: 0.9rem;">Once you upload your Beurer file, your extracted metrics will appear below.</p>
        <div class="table-container">
            <table id="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Weight (kg)</th>
                        <th>BMI</th>
                        <th>Body Fat (%)</th>
                        <th>Muscle (%)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6" style="text-align: center; color: #999;">No data loaded yet. Please upload your CSV above.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function processFiles() {
    const fileInput = document.getElementById('scale-file');
    const statusDiv = document.getElementById('upload-status');
    const tableBody = document.querySelector('#data-table tbody');
    
    if (!fileInput.files || fileInput.files.length === 0) {
        alert('Please select your Beurer CSV file first.');
        return;
    }

    const file = fileInput.files[0];
    const reader = new FileReader();

    reader.onload = function(e) {
        const text = e.target.result;
        const lines = text.split('\n');
        
        let dataStarted = false;
        let recordsHtml = '';
        let rowCount = 0;

        for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            
            // Skip empty lines
            if (!line) continue;

            // Detect where the actual data table starts
            if (line.startsWith('Date;Time;kg')) {
                dataStarted = true;
                continue; // Skip the header row itself loop
            }

            // If we are in the data section, parse the semicolon separated values
            if (dataStarted) {
                const columns = line.split(';');
                if (columns.length >= 7) {
                    const date = columns[0] || '-';
                    const time = columns[1] || '-';
                    const kg = columns[2] || '-';
                    const bmi = columns[3] || '-';
                    const fat = columns[4] || '-';
                    const muscle = columns[6] || '-';

                    recordsHtml += `
                        <tr>
                            <td><b>${date}</b></td>
                            <td>${time}</td>
                            <td>${kg} kg</td>
                            <td>${bmi}</td>
                            <td>${fat ? fat + '%' : '-'}</td>
                            <td>${muscle ? muscle + '%' : '-'}</td>
                        </tr>
                    `;
                    rowCount++;
                }
            }
        }

        if (rowCount > 0) {
            tableBody.innerHTML = recordsHtml;
            statusDiv.innerText = `Successfully loaded ${rowCount} scale records!`;
        } else {
            alert("Could not find the data structure in the file. Make sure it's the right Beurer CSV export.");
        }
    };

    reader.readAsText(file);
}
</script>

</body>
</html>
